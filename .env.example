# Optional: Mapbox access token for the "dark-v11" tile style.
# If left unset, the app falls back to a free CARTO dark basemap
# and continues to work fully — it will not crash.
VITE_MAPBOX_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN

# Base URL for the future FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000/api

# Set to "false" once the FastAPI backend is live to stop using
# the local mock data and start calling VITE_API_BASE_URL instead.
VITE_USE_MOCK=true
